#!/usr/bin/python3
"""yt-tui — a friendly full-screen TUI around yt-dlp.

Pick quality and file type with ↑/↓ + Enter, type where to save it.
Usage: yt-tui [URL]
"""
import curses
import glob
import json
import locale
import os
import queue
import shutil
import subprocess
import sys
import threading
import time
import unicodedata

locale.setlocale(locale.LC_ALL, "")
os.environ.setdefault("ESCDELAY", "25")

HOME = os.path.expanduser("~")
STEPS = ["Quality", "Format", "Save to", "Download"]
VIDEO_TYPES = [("mp4", "H.264 · plays everywhere"),
               ("mkv", "best codec (VP9/AV1) · mpv, VLC"),
               ("webm", "VP9/AV1 · open web format")]
AUDIO_TYPES = [("mp3", "universal"),
               ("m4a", "AAC · Apple friendly"),
               ("opus", "smallest at the same quality"),
               ("flac", "lossless container"),
               ("wav", "uncompressed")]
LOSSY = {"mp3", "m4a", "opus"}
BITRATES = [("Best", "0", "highest VBR quality"),
            ("320 kbps", "320K", "≈ 2.4 MB / min"),
            ("192 kbps", "192K", "≈ 1.4 MB / min"),
            ("128 kbps", "128K", "≈ 0.9 MB / min")]
FALLBACK_HEIGHTS = [2160, 1440, 1080, 720, 480, 360]
PP_NAMES = {"Merger": "Merging video + audio", "ExtractAudio": "Converting audio",
            "EmbedThumbnail": "Embedding thumbnail", "Metadata": "Writing metadata",
            "VideoRemuxer": "Remuxing", "ThumbnailsConvertor": "Preparing thumbnail",
            "MoveFiles": "Finishing up", "FixupM3u8": "Fixing container",
            "FixupM4a": "Fixing container", "EmbedSubtitle": "Embedding subtitles"}
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


# ── theme ───────────────────────────────────────────────────────────────────
class T:
    accent = tag = dim = sel = ok = err = border = field = track = bold = 0


def init_theme():
    T.bold = curses.A_BOLD
    try:
        curses.start_color()
        curses.use_default_colors()
        rich = curses.COLORS >= 256

        def pair(n, fg, bg=-1):
            curses.init_pair(n, fg, bg)
            return curses.color_pair(n)
        C = curses
        T.accent = pair(1, 203 if rich else C.COLOR_RED) | C.A_BOLD
        T.sel = pair(2, 231 if rich else C.COLOR_WHITE, 161 if rich else C.COLOR_RED) | C.A_BOLD
        T.dim = pair(3, 245) if rich else C.A_DIM
        T.ok = pair(4, 114 if rich else C.COLOR_GREEN) | C.A_BOLD
        T.err = pair(5, 210 if rich else C.COLOR_RED) | C.A_BOLD
        T.tag = pair(6, 117 if rich else C.COLOR_CYAN)
        T.border = pair(7, 239) if rich else C.A_DIM
        T.field = pair(8, 255 if rich else C.COLOR_WHITE, 237 if rich else C.COLOR_BLACK)
        T.track = pair(9, 237) if rich else C.A_DIM
    except curses.error:
        T.accent, T.sel, T.dim = curses.A_BOLD, curses.A_REVERSE, curses.A_DIM
        T.ok = T.err = T.tag = curses.A_BOLD
        T.border = T.track = curses.A_DIM
        T.field = curses.A_UNDERLINE


# ── text helpers ────────────────────────────────────────────────────────────
def cells(s):
    return sum(0 if unicodedata.combining(c) else
               2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def trunc(s, n):
    if n <= 0:
        return ""
    if cells(s) <= n:
        return s
    out, w = "", 0
    for c in s:
        if w + cells(c) > n - 1:
            break
        out, w = out + c, w + cells(c)
    return out + "…"


def put(scr, y, x, s, attr=0):
    try:
        scr.addstr(y, x, s, attr)
    except curses.error:
        pass


def human(n):
    if not n:
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def clock(sec):
    sec = int(sec or 0)
    h, rem = divmod(sec, 3600)
    return f"{h}:{rem // 60:02d}:{rem % 60:02d}" if h else f"{rem // 60}:{rem % 60:02d}"


def tilde(p):
    return "~" + p[len(HOME):] if p == HOME or p.startswith(HOME + "/") else p


def L(*segs, right=(), fill=None, cursor=None, rule=False):
    """One line in the card: left segments, right-aligned segments, row fill."""
    return {"left": segs, "right": right, "fill": fill, "cursor": cursor, "rule": rule}


# ── keys ────────────────────────────────────────────────────────────────────
KEYMAP = {curses.KEY_UP: "UP", curses.KEY_DOWN: "DOWN", curses.KEY_LEFT: "LEFT",
          curses.KEY_RIGHT: "RIGHT", curses.KEY_HOME: "HOME", curses.KEY_END: "END",
          curses.KEY_BACKSPACE: "BS", curses.KEY_DC: "DEL", curses.KEY_ENTER: "ENTER",
          curses.KEY_RESIZE: "RESIZE", curses.KEY_PPAGE: "PGUP", curses.KEY_NPAGE: "PGDN"}
CHARMAP = {"\n": "ENTER", "\r": "ENTER", "\x7f": "BS", "\x08": "BS", "\t": "TAB",
           "\x15": "KILL", "\x17": "WORD", "\x01": "HOME", "\x05": "END"}
SEQMAP = {"[A": "UP", "OA": "UP", "[B": "DOWN", "OB": "DOWN", "[C": "RIGHT",
          "OC": "RIGHT", "[D": "LEFT", "OD": "LEFT", "[H": "HOME", "OH": "HOME",
          "[F": "END", "OF": "END", "[1~": "HOME", "[4~": "END", "[3~": "DEL",
          "[5~": "PGUP", "[6~": "PGDN"}


def read_key(scr, timeout=-1):
    """Named key ("UP", "ENTER", …), a single typed character, or None."""
    scr.timeout(timeout)
    try:
        k = scr.get_wch()
    except curses.error:
        return None
    if isinstance(k, int):
        return KEYMAP.get(k)
    if k == "\x1b":  # escape sequences terminfo didn't decode
        scr.nodelay(True)
        seq = ""
        while True:
            try:
                c = scr.get_wch()
            except curses.error:
                break
            seq += c if isinstance(c, str) else ""
        scr.timeout(timeout)
        return "ESC" if not seq else SEQMAP.get(seq)
    if k in CHARMAP:
        return CHARMAP[k]
    return k if k.isprintable() else None


# ── app state ───────────────────────────────────────────────────────────────
class State:
    def __init__(self, url):
        self.url = url
        self.info = None          # probe result
        self.error = None
        self.rows = []            # quality rows
        self.audio = None         # best audio format summary
        self.kind = "video"
        self.height = None
        self.qlabel = ""
        self.size = None
        self.ftype = None
        self.bitrate = None
        self.outdir = None
        self.picked = {}          # remembered cursor per screen
        self.version = ""
        threading.Thread(target=self._version, daemon=True).start()

    def _version(self):
        try:
            self.version = subprocess.run(["yt-dlp", "--version"], capture_output=True,
                                          text=True, timeout=10).stdout.strip()
        except Exception:
            pass

    @property
    def playlist(self):
        return bool(self.info) and self.info.get("_type") == "playlist"

    def crumbs(self):
        """Breadcrumb labels: chosen value for finished steps."""
        out = [self.qlabel or STEPS[0]]
        fmt = self.ftype or STEPS[1]
        if self.ftype and self.bitrate:
            fmt += " " + dict((b[1], b[0]) for b in BITRATES)[self.bitrate].replace(" kbps", "k")
        out.append(fmt)
        out.append(tilde(self.outdir) if self.outdir else STEPS[2])
        out.append(STEPS[3])
        return out


# ── drawing ─────────────────────────────────────────────────────────────────
def header(st, step):
    lines = [L()]
    if st.info:
        i = st.info
        lines.append(L((i.get("title") or st.url, T.bold)))
        meta = []
        if st.playlist:
            n = i.get("playlist_count") or len(i.get("entries") or [])
            meta.append(f"Playlist · {n} videos")
        if i.get("uploader") or i.get("channel"):
            meta.append(i.get("uploader") or i.get("channel"))
        if i.get("duration"):
            meta.append(clock(i["duration"]))
        if i.get("view_count"):
            v = i["view_count"]
            meta.append((f"{v / 1e9:.1f}B" if v >= 1e9 else f"{v / 1e6:.1f}M" if v >= 1e6
                         else f"{v / 1e3:.0f}K" if v >= 1e3 else str(v)) + " views")
        lines.append(L((" · ".join(meta), T.dim)))
    else:
        lines.append(L(("Download video & audio from YouTube and 1000+ sites", T.dim)))
    if step is not None:
        lines.append(L())
        segs = []
        for n, label in enumerate(st.crumbs()):
            if n:
                segs.append((" ── ", T.border))
            if n < step:
                segs.append(("✓ " + label, T.ok))
            elif n == step:
                segs.append(("● " + label, T.accent))
            else:
                segs.append(("○ " + label, T.dim))
        lines.append(L(*segs))
    lines.append(L(rule=True))
    lines.append(L())
    return lines


def frame(scr, st, step, body, footer):
    scr.erase()
    h, w = scr.getmaxyx()
    W = max(20, min(84, w))
    inner = W - 6
    lines = header(st, step) + body + [L()]
    H = min(len(lines) + 2, h)
    y0 = 1 if h >= H + 2 else 0
    x0 = max(0, (w - W) // 2)

    title = " ▶ yt-tui "
    ver = f" yt-dlp {st.version} " if st.version else ""
    put(scr, y0, x0, "╭─", T.border)
    put(scr, y0, x0 + 2, title, T.accent)
    gap = W - 3 - cells(title) - cells(ver) - 1
    put(scr, y0, x0 + 2 + cells(title), "─" * max(0, gap), T.border)
    put(scr, y0, x0 + W - 2 - cells(ver), ver, T.dim)
    put(scr, y0, x0 + W - 2, "─╮", T.border)

    cursor = None
    for n, line in enumerate(lines[:H - 2]):
        y = y0 + 1 + n
        put(scr, y, x0, "│", T.border)
        put(scr, y, x0 + W - 1, "│", T.border)
        if line["rule"]:
            put(scr, y, x0 + 3, "─" * inner, T.border)
        if line["fill"] is not None:
            put(scr, y, x0 + 2, " " * (inner + 2), line["fill"])
        rtext = "".join(t for t, _ in line["right"])
        room = inner - (cells(rtext) + 2 if rtext else 0)
        x = x0 + 3
        for text, attr in line["left"]:
            text = trunc(text, room - (x - x0 - 3))
            put(scr, y, x, text, attr)
            x += cells(text)
        rx = x0 + 3 + inner - cells(rtext)
        for text, attr in line["right"]:
            put(scr, y, rx, text, attr)
            rx += cells(text)
        if line["cursor"] is not None:
            cursor = (y, x0 + 3 + line["cursor"])

    yb = y0 + min(len(lines), H - 2) + 1
    foot = f" {footer} " if footer else ""
    put(scr, yb, x0, "╰─", T.border)
    put(scr, yb, x0 + 2, trunc(foot, W - 6), T.dim)
    put(scr, yb, x0 + 2 + cells(trunc(foot, W - 6)),
        "─" * max(0, W - 4 - cells(foot)), T.border)
    put(scr, yb, x0 + W - 2, "─╯", T.border)

    if cursor:
        curses.curs_set(1)
        try:
            scr.move(*cursor)
        except curses.error:
            pass
    else:
        curses.curs_set(0)
    scr.refresh()
    return inner


def body_room(scr, st, step, extra):
    h, _ = scr.getmaxyx()
    return max(3, h - len(header(st, step)) - 4 - extra)


# ── screens ─────────────────────────────────────────────────────────────────
def menu(scr, st, step, key, prompt, options, note=None):
    """options: list of (label, tag, detail). Returns index or None for back."""
    idx = min(st.picked.get(key, 0), len(options) - 1)
    lw = max(cells(o[0]) for o in options)
    tw = max(cells(o[1]) for o in options)
    while True:
        extra = 1 + (1 if note else 0)
        view = body_room(scr, st, step, extra + 2)
        top = min(max(0, idx - view + 1), max(0, len(options) - view))
        top = min(top, idx)
        body = [L((prompt, T.bold))]
        if note:
            body.append(L(note))
        body.append(L(("  ↑ more", T.dim)) if top else L())
        for n in range(top, min(len(options), top + view)):
            label, tag, detail = options[n]
            text = label + " " * (lw - cells(label) + 2) + tag + " " * (tw - cells(tag))
            if n == idx:
                body.append(L((" ❯ " + text, T.sel), right=((detail + " ", T.sel),), fill=T.sel))
            else:
                body.append(L(("   " + label + " " * (lw - cells(label) + 2), 0),
                              (tag, T.tag), right=((detail + " ", T.dim),)))
        body.append(L(("  ↓ more", T.dim)) if top + view < len(options) else L())
        frame(scr, st, step, body, "↑↓ move · ⏎ select · esc back")
        k = read_key(scr)
        if k in ("UP", "k"):
            idx = (idx - 1) % len(options)
        elif k in ("DOWN", "j"):
            idx = (idx + 1) % len(options)
        elif k in ("HOME", "PGUP"):
            idx = 0
        elif k in ("END", "PGDN"):
            idx = len(options) - 1
        elif k == "ENTER":
            st.picked[key] = idx
            return idx
        elif k in ("ESC", "q", "LEFT"):
            return None


def complete_dir(text):
    """Tab-complete a directory path. Returns (new_text, candidates)."""
    exp = os.path.expanduser(text)
    matches = sorted(m for m in glob.glob(glob.escape(exp) + "*") if os.path.isdir(m))
    if not matches:
        return text, []
    common = os.path.commonprefix(matches)
    if len(matches) == 1:
        common += "/"
    if text.startswith("~"):
        common = tilde(common)
    return (common if len(common) >= len(text) else text), matches


def text_input(scr, st, step, prompt, default="", hint="", is_path=False):
    buf, pos, cands, error = list(default), len(default), [], ""
    while True:
        h, w = scr.getmaxyx()
        inner = max(20, min(84, w)) - 6
        text = "".join(buf)
        field_w = inner - 4
        # scroll so the cursor stays visible
        start = 0
        while cells(text[start:pos]) > field_w - 1:
            start += 1
        visible = text[start:]
        while cells(visible) > field_w:
            visible = visible[:-1]
        body = [L((prompt, T.bold)), L(),
                L((" ❯ ", T.field | T.bold), (visible, T.field), fill=T.field,
                  cursor=3 + cells(text[start:pos]))]
        if error:
            body.append(L(("  " + error, T.err)))
        elif is_path:
            body.append(L(("  " + path_status(text), T.dim)))
        else:
            body.append(L(("  " + hint, T.dim)) if hint else L())
        if cands:
            body.append(L())
            names = [os.path.basename(c.rstrip("/")) + "/" for c in cands]
            line, shown = "  ", 0
            for nm in names:
                if cells(line + nm) > inner - 8:
                    break
                line += nm + "   "
                shown += 1
            body.append(L((line, T.tag),
                          (f"+{len(names) - shown} more" if shown < len(names) else "", T.dim)))
        foot = "⏎ confirm · tab complete · esc back" if is_path else "⏎ confirm · esc quit"
        frame(scr, st, step, body, foot)
        k = read_key(scr)
        error = ""
        if k is None or k == "RESIZE":
            continue
        if k != "TAB":
            cands = []
        if k == "ENTER":
            if text.strip():
                return text.strip()
            error = "Please enter something first"
        elif k == "ESC":
            return None
        elif k == "BS" and pos:
            del buf[pos - 1]
            pos -= 1
        elif k == "DEL" and pos < len(buf):
            del buf[pos]
        elif k == "LEFT":
            pos = max(0, pos - 1)
        elif k == "RIGHT":
            pos = min(len(buf), pos + 1)
        elif k == "HOME":
            pos = 0
        elif k == "END":
            pos = len(buf)
        elif k == "KILL":
            del buf[:pos]
            pos = 0
        elif k == "WORD":
            cut = pos
            while cut and buf[cut - 1] in " /":
                cut -= 1
            while cut and buf[cut - 1] not in " /":
                cut -= 1
            del buf[cut:pos]
            pos = cut
        elif k == "TAB" and is_path:
            new, cands = complete_dir(text[:pos])
            buf = list(new + text[pos:])
            pos = len(new)
            if len(cands) == 1:
                cands = []
        elif len(k) == 1:
            buf.insert(pos, k)
            pos += 1


def path_status(text):
    p = os.path.abspath(os.path.expanduser(text.strip() or "."))
    probe = p
    while not os.path.exists(probe):
        probe = os.path.dirname(probe)
    try:
        free = human(shutil.disk_usage(probe).free) + " free"
    except OSError:
        free = ""
    if os.path.isdir(p):
        return f"✓ folder exists · {free}"
    if os.path.exists(p):
        return "✗ that's a file, not a folder"
    return f"+ folder will be created · {free}"


def summarize(info):
    """Quality rows [(height, fps, size, codecs)] and best-audio summary."""
    fmts = info.get("formats") or []
    dur = info.get("duration") or 0

    def size(f):
        if not f:
            return 0
        return f.get("filesize") or f.get("filesize_approx") or \
            ((f.get("tbr") or 0) * dur * 125)

    def codec(c):
        c = (c or "").split(".")[0].lower()
        return {"avc1": "h264", "avc3": "h264", "vp09": "vp9", "av01": "av1",
                "hev1": "h265", "hvc1": "h265", "mp4a": "aac"}.get(c, c)

    audio = [f for f in fmts if f.get("vcodec") == "none" and f.get("acodec") not in (None, "none")]
    best_a = max(audio, key=lambda f: f.get("abr") or f.get("tbr") or 0, default=None)
    by_h = {}
    for f in fmts:
        hgt = f.get("height")
        if not hgt or f.get("vcodec") == "none":
            continue
        by_h.setdefault(hgt, []).append(f)
    rows = []
    for hgt in sorted(by_h, reverse=True):
        group = by_h[hgt]
        top = max(group, key=lambda f: f.get("tbr") or 0)
        sz = size(top) + (size(best_a) if top.get("acodec") in (None, "none") else 0)
        fps = max(int(f.get("fps") or 0) for f in group)
        codecs = []
        for f in sorted(group, key=lambda f: -(f.get("tbr") or 0)):
            c = codec(f.get("vcodec"))
            if c and c not in codecs and c != "none":
                codecs.append(c)
        hdr = any((f.get("dynamic_range") or "SDR") != "SDR" for f in group)
        rows.append((hgt, fps, sz, codecs, hdr))
    a = None
    if best_a:
        a = (size(best_a), codec(best_a.get("acodec")), int(best_a.get("abr") or 0))
    return rows, a


def probe_screen(scr, st):
    st.info, st.error = None, None
    result = {}

    def work():
        try:
            r = subprocess.run(["yt-dlp", "-J", "--flat-playlist", "--no-playlist",
                                "--no-warnings", st.url], capture_output=True, text=True)
            if r.returncode == 0:
                result["info"] = json.loads(r.stdout)
            else:
                lines = r.stderr.strip().splitlines() or ["unknown error"]
                result["error"] = lines[-1].replace("ERROR: ", "")
        except Exception as e:
            result["error"] = str(e)
    t = threading.Thread(target=work, daemon=True)
    t.start()
    n = 0
    while t.is_alive():
        frame(scr, st, None, [L((SPINNER[n % len(SPINNER)] + " ", T.accent),
                                ("Fetching video info…", T.bold)),
                              L(("  " + trunc(st.url, 70), T.dim))], "esc cancel")
        n += 1
        if read_key(scr, 80) == "ESC":
            return False
    st.info, st.error = result.get("info"), result.get("error")
    if st.info and not st.playlist:
        st.rows, st.audio = summarize(st.info)
    else:
        st.rows, st.audio = [], None
    if not st.rows:
        st.rows = [(hgt, 0, 0, [], False) for hgt in FALLBACK_HEIGHTS]
    return True


def quality_options(st):
    def name(hgt):
        return ("8K" if hgt >= 4320 else "4K" if hgt >= 2160 else "QHD" if hgt >= 1440
                else "Full HD" if hgt >= 1080 else "HD" if hgt >= 720 else "SD")

    def detail(sz, codecs, hdr):
        bits = [f"≈ {human(sz)}"] if sz else []
        if codecs:
            bits.append("/".join(codecs[:3]))
        if hdr:
            bits.append("HDR")
        return " · ".join(bits)

    opts = []
    top = st.rows[0]
    opts.append((("video", None, "Best"), ("Best available", "auto", detail(top[2], top[3][:1], top[4]))))
    for hgt, fps, sz, codecs, hdr in st.rows:
        label = f"{hgt}p{fps if fps > 30 else ''}"
        opts.append((("video", hgt, label), (label, name(hgt), detail(sz, codecs, hdr))))
    a = st.audio
    adetail = " · ".join(x for x in [f"≈ {human(a[0])}" if a and a[0] else "",
                                     a[1] if a else "", f"{a[2]}k" if a and a[2] else ""] if x)
    opts.append((("audio", None, "Audio"), ("Audio only", "♪", adetail)))
    return opts


def confirm_screen(scr, st):
    rows = [("Quality", st.qlabel), ("Format", st.ftype + (
        f" · {dict((b[1], b[0]) for b in BITRATES)[st.bitrate]}"
        if st.bitrate else "")),
        ("Save to", tilde(st.outdir))]
    if st.size:
        rows.append(("Size", f"≈ {human(st.size)}"))
    idx = 0
    acts = ["⬇  Start download", "←  Change something"]
    while True:
        body = [L(("Ready to download", T.bold)), L()]
        for k, v in rows:
            body.append(L((f"  {k:<9}", T.dim), (v, 0)))
        body.append(L())
        for n, a in enumerate(acts):
            body.append(L((" ❯ " + a, T.sel), fill=T.sel) if n == idx else L(("   " + a, 0)))
        frame(scr, st, 3, body, "↑↓ move · ⏎ select · esc back")
        k = read_key(scr)
        if k in ("UP", "DOWN", "k", "j", "TAB"):
            idx ^= 1
        elif k == "ENTER":
            return idx == 0
        elif k in ("ESC", "q", "LEFT"):
            return False


def build_cmd(st):
    outtmpl = ("%(playlist_title)s/%(playlist_index)03d - %(title)s.%(ext)s" if st.playlist
               else "%(title)s [%(id)s].%(ext)s")
    cmd = ["yt-dlp", "-P", st.outdir, "-o", outtmpl, "--no-playlist", "--embed-metadata",
           "--newline", "--progress", "--no-warnings",
           "--progress-template",
           "download:DL|%(info.vcodec)s|%(info.playlist_index)s|%(info.n_entries)s|"
           "%(progress.status)s|%(progress.downloaded_bytes)s|%(progress.total_bytes)s|"
           "%(progress.total_bytes_estimate)s|%(progress.speed)s|%(progress.eta)s",
           "--progress-template", "postprocess:PP|%(progress.postprocessor)s|%(progress.status)s",
           "--print", "after_move:FILE|%(filepath)s"]
    if st.kind == "audio":
        cmd += ["-f", "ba/b", "-x", "--audio-format", st.ftype, "--audio-quality", st.bitrate or "0"]
        if st.ftype != "wav":
            cmd += ["--embed-thumbnail"]
    else:
        sort = [f"res:{st.height}"] if st.height else []
        if st.ftype == "mp4":
            sort += ["vcodec:h264", "ext:mp4:m4a"]
        elif st.ftype == "webm":
            sort += ["ext:webm:webm"]
        cmd += ["-f", "bv*+ba/b", "--merge-output-format", st.ftype, "--remux-video", st.ftype]
        if sort:
            cmd += ["-S", ",".join(sort)]
        if st.ftype in ("mp4", "mkv"):
            cmd += ["--embed-thumbnail", "--embed-chapters"]
    return cmd + [st.url]


def num(s):
    try:
        return float(s)
    except (TypeError, ValueError):
        return None


def bar(width, frac):
    """Smooth progress bar segments using half-cell resolution."""
    frac = max(0.0, min(1.0, frac))
    halves = int(frac * width * 2)
    full, half = divmod(halves, 2)
    segs = [("━" * full, T.accent)]
    if half:
        segs.append(("╸", T.accent))
    segs.append(("━" * (width - full - half), T.track))
    return segs


def bounce(width, n):
    w = max(4, width // 6)
    span = width - w
    pos = n % (2 * span) if span else 0
    pos = 2 * span - pos if pos > span else pos
    return [("━" * pos, T.track), ("━" * w, T.accent), ("━" * (width - pos - w), T.track)]


def download_screen(scr, st):
    proc = subprocess.Popen(build_cmd(st), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1)
    q = queue.Queue()

    def reader():
        for line in proc.stdout:
            q.put(line.rstrip("\n"))
        q.put(None)
    threading.Thread(target=reader, daemon=True).start()

    stage, prog, item, files, errors, log = "Preparing download…", None, None, [], [], []
    started, n, done, cancelled = time.time(), 0, False, False
    while True:
        try:
            while True:
                line = q.get_nowait()
                if line is None:
                    done = True
                    break
                if line.startswith("DL|"):
                    p = line.split("|")
                    vc, idx, cnt, status = p[1], p[2], p[3], p[4]
                    got, tot = num(p[5]), num(p[6]) or num(p[7])
                    stage = "Downloading " + ("audio" if vc == "none" else
                                              "video" if st.kind == "video" else "media")
                    prog = (got, tot, num(p[8]), num(p[9])) if status == "downloading" else (tot, tot, None, 0)
                    item = (idx, cnt) if idx not in ("NA", "") else None
                elif line.startswith("PP|"):
                    _, name, status = line.split("|", 2)
                    if status == "started":
                        stage = PP_NAMES.get(name.replace("FFmpeg", ""), name) + "…"
                        prog = None
                elif line.startswith("FILE|"):
                    files.append(line[5:])
                elif line.strip():
                    (errors if line.startswith("ERROR") else log).append(line)
        except queue.Empty:
            pass
        if done:
            proc.wait()
            break

        h, w = scr.getmaxyx()
        inner = max(20, min(84, w)) - 6
        bw = inner - 8
        body = [L((SPINNER[n % len(SPINNER)] + " ", T.accent), (stage, T.bold),
                  right=((f"item {item[0]} of {item[1]}", T.tag),) if item and item[1] != "NA" else ()),
                L()]
        if prog and prog[1]:
            got, tot, speed, eta = prog
            frac = (got or 0) / tot
            body.append(L(*bar(bw, frac), (f" {frac * 100:5.1f}%", T.bold)))
            info = [f"{human(got)} / {human(tot)}"]
            if speed:
                info.append(f"{human(speed)}/s")
            if eta:
                info.append(f"ETA {clock(eta)}")
            body.append(L(("   ·   ".join(info), T.dim)))
        else:
            body.append(L(*bounce(bw, n)))
            body.append(L((f"elapsed {clock(time.time() - started)}", T.dim)))
        body.append(L())
        for msg in (errors + log)[-3:]:
            body.append(L(("  " + msg, T.err if msg.startswith("ERROR") else T.dim)))
        frame(scr, st, 3, body, "esc cancel")
        n += 1
        if read_key(scr, 100) == "ESC":
            proc.terminate()
            cancelled = True
    return proc.returncode, files, errors or log[-3:], cancelled

